# Copiar este archivo como .env (en esta misma carpeta) y completar. El .env NO se sube a GitHub.

# Dominio o subdominio que apunta al servidor, sin https:// (ej: panel.mitienda.com.ar)
DOMINIO=panel.ejemplo.com.ar

# Dirección pública completa del conector, con https:// (la misma del DOMINIO)
URL_PUBLICA=https://panel.ejemplo.com.ar

# Clave para entrar al panel: larga y al azar. Generarla con:  openssl rand -hex 24
ADMIN_TOKEN=

# Datos de la app creada en el portal de Tiendanube Partners
TN_APP_ID=
TN_APP_SECRETO=

# Un email o página de contacto: Tiendanube exige que la app se identifique
TN_CONTACTO=

# (Opcional pero recomendado) Número de la tienda de la clienta: la app solo se podrá instalar ahí
TN_TIENDA_ID=
